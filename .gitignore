dist-ssr/
.sass-cache/
out/
tmp/**
presentation
presentation.zip
slides-template/dist/reveal.es5.js
slides-template/react/dist
slides-template/react/demo/dist

# Resume (LaTeX build at repo root)
resume/build/

# Dev / preview
dev.html

